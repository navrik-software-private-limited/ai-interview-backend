# Config for tests/e2e/happyPath.test.js ONLY. `npm test` (unit + integration)
# never reads this file — every external dependency is mocked there.
#
# Left blank on purpose: the E2E suite self-skips with a clear message when
# these aren't set, rather than accidentally running against a real database.
# NEVER point these at the production or shared dev database — provision a
# separate, dedicated test database (schema.sql applied) before filling this in.

TEST_DB_SERVER=
TEST_DB_DATABASE=
TEST_DB_USER=
TEST_DB_PASSWORD=

# Optional — defaults to 127.0.0.1 if unset. Only needs to be a real Redis
# instance reachable from wherever these tests run; REDIS_PREFIX is forced to
# "e2e-test:" by the suite itself so it can never collide with real session keys.
TEST_REDIS_HOST=

# Required by session/sessionCreationController.js's internal-key auth path
# and by the JWT the E2E test signs — must match whatever ai-interview-backend
# itself is configured with for the environment TEST_DB_* points at.
INTERNAL_SERVICE_KEY=
JWT_INTERVIEW_ACCESS_TOKEN_SECRET_KEY=
